# ─────────────────────────────────────────────────────────────────────────────
# ROHA — environment configuration
# Copy to .env.local for local development. NEVER commit real secrets.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser; all others are
# server-only.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the application (used for auth redirects, survey links, Stripe returns)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: NEXT_PUBLIC_APP_URL=https://roha.droscarrodriguez.com

# Supabase (Project Settings → API). REQUIRED.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: server only. Bypasses RLS — never expose to the browser. REQUIRED.
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to hash participation tokens/access codes and rate-limit keys. REQUIRED.
# Generate with: openssl rand -hex 32   (changing it invalidates in-flight survey tokens)
ROHA_TOKEN_SECRET=

# Comma-separated emails promoted to Rodrik Consulting super-administrators once verified.
ROHA_PLATFORM_ADMIN_EMAILS=

# Anthropic (AI executive reports). OPTIONAL — without it, reports fall back to
# the deterministic rules-based summary.
ANTHROPIC_API_KEY=
# Model used for executive reports (default: claude-opus-5)
ROHA_AI_MODEL=claude-opus-5

# Stripe (paid plans). OPTIONAL — free ROHA Discover works without it.
# Set each paid plan's stripe_price_id in Super Admin → Plans.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Protects /api/cron/retention (Vercel Cron sends "Authorization: Bearer $CRON_SECRET").
CRON_SECRET=
